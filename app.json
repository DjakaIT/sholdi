{
  "expo": {
    "name": "Sholdi",
    "slug": "sholdi",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "sholdi",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#131114",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sholdi.app"
    },
    "android": {
      "package": "com.sholdi.app",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#131114"
      }
    },
    "web": {
      "output": "static",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Sholdi reads receipts and photos you choose. They are never stored.",
          "cameraPermission": "Sholdi uses the camera to scan a receipt. Photos are never stored."
        }
      ],
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d291b4a3-9901-4a66-ad6b-68b533dc49c0"
      }
    }
  }
}
