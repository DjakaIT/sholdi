# Where the AI functions are deployed, and the key that gates them.
#
# These are the ONLY backend values the app needs. There is no database: every
# expense lives in SQLite on the device. The functions are stateless — they read a
# statement, receipt or note and return structured expenses, storing nothing.
EXPO_PUBLIC_FUNCTIONS_URL=https://<project-ref>.supabase.co/functions/v1
EXPO_PUBLIC_FUNCTIONS_KEY=<anon key>

# The Anthropic key is NOT here and must never be. ARCHITECTURE.md §4.1: an
# EXPO_PUBLIC_* var is readable by anyone with the APK. Set it as a secret on the
# functions instead:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#
# Note on EXPO_PUBLIC_FUNCTIONS_KEY: it ships inside the app and can be extracted,
# so it stops a passer-by, not a determined one. Put a spend cap on the Anthropic
# key before launch.
