# Supabase. The anon key is public by design and is protected by RLS (see
# supabase/migrations). Safe to ship in the bundle.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The Anthropic key is NOT here and must never be. ARCHITECTURE.md §4.1: an
# EXPO_PUBLIC_* var is readable by anyone with the APK. Set it as a secret on the
# Edge Functions instead:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
